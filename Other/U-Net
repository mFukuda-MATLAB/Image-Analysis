%% Apply Trained U-Net to New Images

clc; clear; warning('off','all'); close all;

% Path
BFinitial_path = 'D:/Image Process DNA/U_Net/Patched Image Segmentation/Original BF Images';
Model_save_path = 'D:/Image Process DNA/U_Net/Model';
UNetResult_path = 'D:/Image Process DNA/U_Net/Patched Image Segmentation/Mask by UNet'; mkdir(UNetResult_path);

BForiginal_path = 'D:/Image Process DNA/U_Net/Patched Image Segmentation/Original BF Images'; mkdir(BForiginal_path);
NucProcessed_path = 'D:/Image Process DNA/U_Net/Patched Image Segmentation/Original BF Images'; mkdir(NucProcessed_path);

% Load U-Net Model
load(fullfile(Model_save_path, 'TrainedUnet_Optimized.mat'), 'net');

% Parameters
PatchSize = [128 128];
Contrast_threshold = 0.041;
Noise_threshold = 0.010;

% Load Training Folders
BF_files = dir(fullfile(BFinitial_path, '*.tif'));

ImageCount = 0; % Image counter for saving

for a = 1%:length(BF_files)

    BF_path   = fullfile(BFinitial_path, BF_files(a).name);

    if ~isfile(BF_path)
        continue;
    end

    % Read and Preprocess
    BF = imread(BF_path);

    I_BF = im2double(BF);
    img_contrast = std2(I_BF);
    img_noise = mean(mean(stdfilt(I_BF)));

    if img_noise > Noise_threshold
        I_BF = imgaussfilt(I_BF, 0.8);
    end
    if img_contrast < Contrast_threshold
        I_BF = imadjust(I_BF, [0.2 0.8], [0 1], 1);
    end
    I_processed = medfilt2(I_BF, [3 3]);

    % Pad to Patch Size
    [h, w] = size(I_processed);
    pad_h = ceil(h / PatchSize(1)) * PatchSize(1) - h;
    pad_w = ceil(w / PatchSize(2)) * PatchSize(2) - w;
    I_pad = padarray(I_processed, [pad_h, pad_w], 'post');

    segmented = zeros(size(I_pad), 'uint8');

    % Predict Patch-by-Patch
    for row = 1:PatchSize(1):size(I_pad,1)
        for col = 1:PatchSize(2):size(I_pad,2)
            patch = I_pad(row:row+PatchSize(1)-1, col:col+PatchSize(2)-1);
            patch_input = reshape(patch, [PatchSize, 1]);  % Convert to HxWx1
            prediction = semanticseg(patch_input, net);
            mask = uint8(prediction == "Cell") * 255;
            segmented(row:row+PatchSize(1)-1, col:col+PatchSize(2)-1) = mask;
        end
    end

    % Crop to Original Size
    final_mask = segmented(1:h, 1:w);

    figure()
    imshow(imoverlay(BF,final_mask))

    % Save Result
    % imwrite(final_mask, fullfile(UNetResult_path, sprintf('%d.tif', ImageCount)));
    % ImageCount = ImageCount + 1;
end

